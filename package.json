{
  "name": "lingjing",
  "version": "1.0.0",
  "description": "灵境 · 指间幻境：用手、脸、身体驱动的 AR 互动艺术网页",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "copy-wasm": "node scripts/copy-wasm.mjs",
    "predev": "npm run copy-wasm",
    "dev": "vite",
    "prebuild": "npm run copy-wasm",
    "build": "tsc && vite build",
    "preview": "vite preview --port 4174",
    "test": "vitest run",
    "e2e": "python3 e2e/e2e.py http://127.0.0.1:4174/lingjing/",
    "deploy:gh": "bash scripts/deploy-gh-pages.sh"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
